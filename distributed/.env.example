# =====================================================================
# SmartMonitoring - Federated Learning Configuration Template (.env)
# Copy this file to .env and adjust the values for your deployment.
# =====================================================================

# --- Federated Learning Round Parameters ---
FL_N= 3                           # Total clients required before coordinator starts
FL_K=3                              # Number of clients selected per training round
FL_ROUNDS=5                        # Total number of FL training rounds
FL_AGGREGATOR=select_train          # Server strategy (plugins): select_train (ours), select, train, train_select, fedstrategist, sara,
                                    #   or a rule every round: fedavg, fedyogi, median, krum
FL_SELECTOR=oort                    # Client selector (plugins): oort, random
FL_RULES=                           # Optional candidate rules for the controller, e.g. fedavg,median,krum
FL_PLUGIN_ARGS=                     # Optional JSON controller arguments, e.g. {"preset": "authors", "lambda_cost": 0.5}
FL_NUM_MALICIOUS=0                  # Krum's f (number of malicious clients it assumes)

# --- Client training (TMLR supplement: plain SGD, fresh optimizer every round, unweighted BCE) ---
FL_LOCAL_EPOCHS=5                   # Local epochs per round (sent to the clients with each train command)
FL_LR=0.1                           # Client SGD learning rate (ECG calibration, simple/experiments/ecg_protocol.md)
FL_BATCH_SIZE=32                    # Client (and server-training) batch size

# --- Server learning (select / train / select_train) ---
SERVER_VAL_PATH=server_val.npz      # Server validation set V, relative to server/ (scripts/make_server_val.py)
FL_SERVER_LR=0.01                   # FedYogi server step
FL_FT_EPOCHS=1                      # Epochs of server training on V
FL_FT_LR_SCALE=1.0                  # Server training SGD lr = FL_LR x this
FL_SELECT_FRAC=0.0                  # >0: share of V used only for selection, the rest only for training

# --- Server & Network Settings ---
SERVER_HOST=http://127.0.0.1:8000   # Server base HTTP URL (used for presigned URLs & WS)
HOST=0.0.0.0                        # Uvicorn listen address
PORT=8000                           # Uvicorn listen port
REDIS_URL=redis://localhost:6379/0  # Redis connection URL

# --- AWS / S3 Storage Settings ---
S3_MOCK=false                       # Set to 'false' for real AWS S3 deployment, 'true' for local testing
S3_BUCKET=my-smartmonitoring-fl-bucket
# S3_ENDPOINT_URL=http://localhost:4566   # Optional S3-compatible endpoint (LocalStack, MinIO); leave unset for AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# --- Client Credentials & Defaults ---
PASSWORD=P7h1!quiBO0no96
SERVER_IP=127.0.0.1:8000
CERT_FINGERPRINT=12:0A:9E:87:19:A3:23:AF:49:4D:54:40:67:87:80:CC:80:02:78:45:74:75:86:38:6D:5D:C3:94:67:E1:F2:7A
FL_ATTACK=none                      # Poisoning experiments, per client: none | standard (5x the honest update)
FL_ATTACK_FLIP=false                # true: reverse the update direction
